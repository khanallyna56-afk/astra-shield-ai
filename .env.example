# ---- Database ----
POSTGRES_USER=astra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=astra
DATABASE_URL=postgresql+asyncpg://astra:change-me@db:5432/astra

# ---- Backend ----
# live = fetch CelesTrak / NOAA SWPC (with cache + fixture fallback); offline = fixtures only
DATA_MODE=offline
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info

# ---- Risk formula (design choices, not clinically validated) ----
RISK_W_RADIATION=0.60
RISK_W_SLEEP=0.40

# ---- Frontend (build-time; leave empty to use same-origin /api and /ws via nginx) ----
VITE_API_URL=
VITE_WS_URL=
